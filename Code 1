main.py

from src.database.natural_product_loader import NaturalProductLoader

from src.chemistry.descriptor import calculate_descriptors

from src.chemistry.molecular_graph import smiles_to_graph

from src.models.graph_transformer import GraphTransformer

from src.utils.logger import get_logger



logger=get_logger()



def main():


    logger.info(

        "Starting Natural Products AI"

    )



    loader=NaturalProductLoader(

        "data/example_natural_products.csv"

    )



    compounds=loader.load()



    model=GraphTransformer()



    for _,row in compounds.iterrows():


        print()

        print(

            "Compound:",

            row["name"]

        )



        descriptor = calculate_descriptors(

            row["smiles"]

        )



        print(

            "Properties:",

            descriptor

        )



        graph = smiles_to_graph(

            row["smiles"]

        )



        embedding=model(

            graph["x"]

        )



        print(

            "AI embedding:",

            embedding.shape

        )



    logger.info(

        "Finished"

    )





if __name__=="__main__":

    main()



src/database/natural_product_loader.py

import pandas as pd


class NaturalProductLoader:


    def __init__(self, file):

        self.file = file



    def load(self):

        data = pd.read_csv(self.file)


        data = data.drop_duplicates(
            subset=["smiles"]
        )


        print(
            f"[Database] Loaded {len(data)} compounds"
        )


        return data


src/chemistry/descriptor.py

from rdkit import Chem
from rdkit.Chem import Descriptors
from rdkit.Chem import Crippen
from rdkit.Chem import Lipinski



def calculate_descriptors(smiles):


    mol = Chem.MolFromSmiles(smiles)


    if mol is None:

        return None



    result = {


        "MW":

        Descriptors.MolWt(mol),



        "LogP":

        Crippen.MolLogP(mol),



        "HBD":

        Lipinski.NumHDonors(mol),



        "HBA":

        Lipinski.NumHAcceptors(mol),



        "Rotatable":

        Lipinski.NumRotatableBonds(mol)


    }


    return result


src/chemistry/molecular_graph.py

from rdkit import Chem

import torch



def atom_feature(atom):


    return [

        atom.GetAtomicNum(),

        atom.GetTotalDegree(),

        atom.GetFormalCharge(),

        int(atom.GetIsAromatic())

    ]





def smiles_to_graph(smiles):


    mol = Chem.MolFromSmiles(smiles)


    if mol is None:

        return None



    nodes=[]



    for atom in mol.GetAtoms():

        nodes.append(

            atom_feature(atom)

        )



    x=torch.tensor(

        nodes,

        dtype=torch.float

    )



    edges=[]



    for bond in mol.GetBonds():


        i=bond.GetBeginAtomIdx()

        j=bond.GetEndAtomIdx()


        edges.append([i,j])

        edges.append([j,i])



    edge_index=torch.tensor(

        edges,

        dtype=torch.long

    ).T



    return {


        "x":x,


        "edge_index":edge_index

    }

src/models/graph_transformer.py

import torch
import torch.nn as nn



class GraphTransformer(nn.Module):


    def __init__(

        self,

        input_dim=4,

        hidden_dim=128,

        output_dim=1024

    ):


        super().__init__()



        self.encoder = nn.Sequential(


            nn.Linear(

                input_dim,

                hidden_dim

            ),


            nn.ReLU(),


            nn.Linear(

                hidden_dim,

                output_dim

            )

        )



    def forward(self,x):


        embedding=self.encoder(x)



        embedding=torch.mean(

            embedding,

            dim=0

        )


        return embedding


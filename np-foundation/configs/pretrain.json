{
  "data_path": "../data/processed/compounds.csv",
  "output_dir": "../runs/pretrain",
  "max_records": 50000,
  "seed": 42,
  "max_seq_length": 512,
  "max_atoms": 256,
  "graph_mode": "auto",
  "tasks": [],
  "model": {"d_model": 64, "nhead": 4, "num_layers": 2, "dim_feedforward": 128, "dropout": 0.1, "graph_layers": 2},
  "training": {
    "epochs": 2, "batch_size": 16, "learning_rate": 0.001,
    "objective": "causal", "lm_weight": 1.0, "task_weight": 0.0,
    "contrastive_weight": 0.1, "contrastive_temperature": 0.1,
    "val_fraction": 0.15, "test_fraction": 0.15, "split": "scaffold",
    "selection_metric": "auto", "device": "cpu", "cpu_threads": 4
  }
}
